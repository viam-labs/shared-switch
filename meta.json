{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:shared-switch",
  "visibility": "public",
  "url": "https://github.com/viam-labs/shared-switch",
  "description": "Reference-counted GPIO switch shared across multiple clients.",
